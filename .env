# Agent Framework Environment Configuration
# API Keys
# ANTHROPIC_API_KEY=ANTHROPIC_AUTH_TOKEN
MINIMAX_API_KEY=ANTHROPIC_AUTH_TOKEN

# Model Configuration
MODEL_ID=MiniMax-M2.7

# Anthropic (optional)
